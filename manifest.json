{
  "manifest_version": 3,
  "name": "Twitter Default Following Tab",
  "version": "2.0.1",
  "description": "Auto-switches to Following tab on Twitter/X. Smart detection, zero permissions, privacy-focused. Skip For You feed.",
  "author": "Mustafa ER",
  "homepage_url": "https://github.com/mustafaer/twitter-default-following-tab",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

