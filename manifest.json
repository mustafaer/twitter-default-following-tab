{
  "manifest_version": 3,
  "name": "Twitter Default Following Tab",
  "version": "1.0.0",
  "description": "Automatically switches to the Following tab on Twitter/X. Smart content detection, zero permissions, privacy-focused. Skip the For You feed.",
  "author": "Mustafa ER",
  "homepage_url": "https://github.com/mustafaer/twitter-default-following-tab",
  "keywords": [
    "twitter",
    "following",
    "tab",
    "chronological",
    "timeline",
    "automation",
    "productivity",
    "x.com",
    "social media",
    "feed"
  ],
  "permissions": [],
  "host_permissions": [
    "https://twitter.com/*",
    "https://x.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

